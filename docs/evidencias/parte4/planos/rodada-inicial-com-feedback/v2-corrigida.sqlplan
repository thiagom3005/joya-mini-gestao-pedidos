<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    ROW_NUMBER() OVER (ORDER BY SUM(i.Quantidade * i.PrecoUnitario) DESC, c.Id) AS Posicao,&#xa;    c.Id   AS ClienteId,&#xa;    c.Nome,&#xa;    SUM(i.Quantidade * i.PrecoUnitario) AS Total&#xa;FROM Pedidos p&#xa;INNER JOIN Clientes c    ON c.Id = p.ClienteId&#xa;INNER JOIN ItensPedido i ON i.PedidoId = p.Id&#xa;WHERE p.DataPedido &gt;= &apos;2026-01-01T03:00:00&apos;&#xa;  AND p.DataPedido &lt;  &apos;2027-01-01T03:00:00&apos;&#xa;GROUP BY c.Id, c.Nome&#xa;ORDER BY Total DESC, c.Id" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900B07A5059BB11B5C0A454324FFE90653C0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="5" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.0399" StatementEstRows="1159.8" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x0E9FB98FDB01F3EF" QueryPlanHash="0x04F4B6860EAC30C8" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="6304" CachedPlanSize="120" CompileTime="23" CompileCPU="23" CompileMemory="1248"><MemoryGrantInfo SerialRequiredMemory="5280" SerialDesiredMemory="6304" RequiredMemory="5280" DesiredMemory="6304" RequestedMemory="6304" GrantWaitTime="0" MaxQueryMemory="230496" GrantedMemory="6304" MaxUsedMemory="3120" LastRequestedMemory="6304" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="17476" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="6" MaxCo
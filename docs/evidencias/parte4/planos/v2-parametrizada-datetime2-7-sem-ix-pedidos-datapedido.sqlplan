<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    ROW_NUMBER() OVER (ORDER BY SUM(i.Quantidade * i.PrecoUnitario) DESC, c.Id) AS Posicao,&#xa;    c.Id   AS ClienteId,&#xa;    c.Nome,&#xa;    SUM(i.Quantidade * i.PrecoUnitario) AS Total&#xa;FROM Pedidos p&#xa;INNER JOIN Clientes c    ON c.Id = p.ClienteId&#xa;INNER JOIN ItensPedido i ON i.PedidoId = p.Id&#xa;WHERE p.DataPedido &gt;= @InicioUtc&#xa;  AND p.DataPedido &lt;  @FimExclusivoUtc&#xa;GROUP BY c.Id, c.Nome&#xa;ORDER BY Total DESC, c.Id" StatementId="1" StatementCompId="2" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="3.19322" StatementEstRows="1159.8" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x0E9FB98FDB01F3EF" QueryPlanHash="0xAE6B2B0F1AEC9BD7" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="71496" CachedPlanSize="80" CompileTime="13" CompileCPU="13" CompileMemory="1168"><MissingIndexes><MissingIndexGroup Impact="12.4815"><MissingIndex Database="[JoyaPedidos]" Schema="[dbo]" Table="[Pedidos]"><ColumnGroup Usage="INEQUALITY"><Column Name="[DataPedido]" ColumnId="3"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[ClienteId]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="71496" GrantedMemory="71496" MaxUsedMemory="1632"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="4256" SerialDesiredMemory="71496" RequiredMemory="4256" DesiredMemory="71496" RequestedMemory="71496" GrantWaitTime="0" MaxQue
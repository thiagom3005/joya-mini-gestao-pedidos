<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    ROW_NUMBER() OVER (ORDER BY SUM(i.Quantidade * i.PrecoUnitario) DESC, c.Id) AS Posicao,&#xa;    c.Id   AS ClienteId,&#xa;    c.Nome,&#xa;    SUM(i.Quantidade * i.PrecoUnitario) AS Total&#xa;FROM Pedidos p&#xa;INNER JOIN Clientes c    ON c.Id = p.ClienteId&#xa;INNER JOIN ItensPedido i ON i.PedidoId = p.Id&#xa;WHERE p.DataPedido &gt;= @InicioUtc&#xa;  AND p.DataPedido &lt;  @FimExclusivoUtc&#xa;GROUP BY c.Id, c.Nome&#xa;ORDER BY Total DESC, c.Id" StatementId="1" StatementCompId="3" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="1.92568" StatementEstRows="1159.43" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x0E9FB98FDB01F3EF" QueryPlanHash="0xF3299785E21E6BDD" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="77512" CachedPlanSize="104" CompileTime="10" CompileCPU="10" CompileMemory="1192"><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="77512" GrantedMemory="77512" MaxUsedMemory="3120"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="5280" SerialDesiredMemory="77512" RequiredMemory="5280" DesiredMemory="77512" RequestedMemory="77512" GrantWaitTime="0" MaxQueryMemory="230480" GrantedMemory="77512" MaxUsedMemory="3120"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="17476" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="826960"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><Statistic
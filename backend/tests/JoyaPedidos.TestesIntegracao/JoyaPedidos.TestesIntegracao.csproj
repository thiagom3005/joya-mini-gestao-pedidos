<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testes de integração: endpoints HTTP em processo (WebApplicationFactory) contra SQL Server real via
    Testcontainers, com a mesma imagem e os mesmos scripts do docker-compose (spec §10.1, §10.4). Requer Docker.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>JoyaPedidos.TestesIntegracao</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JoyaPedidos.Api\JoyaPedidos.Api.csproj" />
  </ItemGroup>
</Project>
